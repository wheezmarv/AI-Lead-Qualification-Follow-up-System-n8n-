{
  "name": "AI Lead Qualification & Follow-up System",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  name: (b.name || '').trim(),\n  email: (b.email || '').trim().toLowerCase(),\n  company: (b.company || '').trim(),\n  budget: b.budget || 'not stated',\n  timeline: b.timeline || 'not stated',\n  message: (b.message || '').trim(),\n  source: b.source || 'website',\n  received_at: new Date().toISOString()\n}}];"
      },
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite-preview:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ systemInstruction: { parts: [{ text: \"You are a lead qualification assistant for a home renovation and home services business. Reply ONLY with JSON in this shape: {\\\"intent_summary\\\":\\\"one sentence\\\",\\\"budget_fit\\\":\\\"low|medium|high\\\",\\\"reply_subject\\\":\\\"string\\\",\\\"reply_body\\\":\\\"short friendly personalised plain-text email, signed by the team\\\"}. Write the reply so it responds to what the lead actually asked. Do not promise prices. If the lead seems ready, suggest a short call or site visit.\" }] }, contents: [{ role: 'user', parts: [{ text: 'Lead: ' + JSON.stringify($json) }] }], generationConfig: { responseMimeType: 'application/json', temperature: 0.3 } }) }}",
        "options": {}
      },
      "name": "Gemini Qualify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Gemini (x-goog-api-key)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const parts = $input.first().json.candidates[0].content.parts;\nconst text = parts.filter(p => p.text && !p.thought).map(p => p.text).join('');\nconst ai = JSON.parse(text.replace(/```json|```/g, '').trim());\nconst lead = $('Normalize Lead').first().json;\n\n// Rule-based scoring (predictable, not AI-guessed)\nconst budgetHasAmount = /\\d/.test(String(lead.budget || ''));\nconst timeline = String(lead.timeline || '');\nconst notSoon = /later|maybe|someday|not sure|not stated|next year|no idea/i.test(timeline);\nconst urgent = !notSoon && /asap|urgent|immediately|now|this week|this month|next week|few weeks|two weeks|2 weeks|1 month|one month|days/i.test(timeline);\nconst message = String(lead.message || '');\nconst wantsQuote = /quote|price|cost|charge|how much|estimate|visit|book|available/i.test(message);\n\nlet score = 0;\nif (message.length >= 20) score += 20;\nif (wantsQuote) score += 20;\nif (budgetHasAmount) score += 30;\nif (urgent) score += 20;\nif (lead.company) score += 5;\nif (lead.name) score += 5;\n\nlet tier = 'cold';\nif (budgetHasAmount && urgent) tier = 'hot';\nelse if (score >= 30) tier = 'warm';\n\nreturn [{ json: { ...lead, ...ai, score, tier, status: 'new' } }];"
      },
      "name": "Parse Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "name": "Log to CRM Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        880,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $('Parse Score').item.json.tier }}",
                    "rightValue": "hot",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "hot"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $('Parse Score').item.json.tier }}",
                    "rightValue": "warm",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "warm"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $('Parse Score').item.json.tier }}",
                    "rightValue": "cold",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "cold"
            }
          ]
        },
        "options": {}
      },
      "name": "Route by Tier",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
